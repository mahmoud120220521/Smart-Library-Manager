<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.GridPane?>

<GridPane alignment="CENTER" hgap="15.0" prefHeight="400.0" prefWidth="600.0" vgap="15.0" styleClass="grid-pane" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.smartlibrarymanager.controller.BorrowingController" stylesheets="@./styles.css">
   <padding>
      <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
   </padding>
   <HBox alignment="CENTER_LEFT" spacing="0.0" GridPane.columnIndex="0" GridPane.columnSpan="2" GridPane.rowIndex="0" style="-fx-padding: 10 0 0 10;">
      <Button text="Back" onAction="#handleBack" styleClass="button secondary" minWidth="100.0" prefWidth="120.0" style="-fx-font-size: 15px; -fx-font-weight: bold; margin-left: 0;" />
   </HBox>
   <Label text="Borrow Book" styleClass="label" style="-fx-font-size: 22px; -fx-font-weight: bold; -fx-text-fill: #377dce;" minWidth="300.0" prefWidth="360.0" GridPane.columnIndex="0" GridPane.columnSpan="2" GridPane.rowIndex="1" />
   <HBox alignment="CENTER_LEFT" spacing="16.0" GridPane.columnIndex="0" GridPane.columnSpan="2" GridPane.rowIndex="2">
      <Label text="Select Book" styleClass="label" minWidth="120.0" prefWidth="160.0" />
      <ComboBox fx:id="bookComboBox" promptText="Choose a book" minWidth="200.0" prefWidth="260.0" />
   </HBox>
   <HBox alignment="CENTER_LEFT" spacing="16.0" GridPane.columnIndex="0" GridPane.columnSpan="2" GridPane.rowIndex="3">
      <Label text="Select Member" styleClass="label" minWidth="120.0" prefWidth="160.0" />
      <ComboBox fx:id="memberComboBox" promptText="Choose a member" minWidth="200.0" prefWidth="260.0" />
   </HBox>
   <HBox alignment="CENTER_LEFT" spacing="16.0" GridPane.columnIndex="0" GridPane.columnSpan="2" GridPane.rowIndex="4">
      <Label text="Borrow Date" styleClass="label" minWidth="120.0" prefWidth="160.0" />
      <DatePicker fx:id="borrowDatePicker" promptText="Select date" minWidth="200.0" prefWidth="260.0" />
   </HBox>
   <HBox alignment="CENTER" spacing="16.0" GridPane.columnIndex="0" GridPane.columnSpan="2" GridPane.rowIndex="5">
   <Button text="Borrow Book" onAction="#handleBorrowBook" styleClass="button" minWidth="120.0" prefWidth="180.0" style="-fx-font-size: 16px; -fx-font-weight: bold;" />
   </HBox>
</GridPane>
<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.TextArea?>

<VBox alignment="CENTER" spacing="24.0" xmlns="http://javafx.com/javafx/8" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.smartlibrarymanager.controller.ReportsController" stylesheets="@./styles.css" prefWidth="600.0" prefHeight="400.0">
    <HBox alignment="CENTER_LEFT" spacing="0.0" style="-fx-padding: 10 0 0 10;">
        <Button text="Back" onAction="#handleBack" styleClass="button secondary" minWidth="100.0" prefWidth="120.0" style="-fx-font-size: 15px; -fx-font-weight: bold; margin-left: 0;" />
    </HBox>
    <HBox alignment="CENTER" spacing="16.0">
        <ComboBox fx:id="reportTypeComboBox" promptText="Select report type" minWidth="180.0" />
        <Button fx:id="generateReportButton" text="Generate Report" minWidth="140.0" />
    </HBox>
    <HBox alignment="CENTER" spacing="16.0">
        <TextArea fx:id="reportTextArea" editable="false" wrapText="true" prefWidth="500.0" prefHeight="250.0" />
    </HBox>
</VBox>

<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane prefHeight="600.0" prefWidth="800.0" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.smartlibrarymanager.controller.BooksController" stylesheets="@./styles.css">
   <top>
      <VBox alignment="CENTER" spacing="0.0">
         <HBox alignment="CENTER_LEFT" spacing="0.0" style="-fx-padding: 10 0 0 10;">
            <Button text="Back" onAction="#handleBack" styleClass="button secondary" minWidth="100.0" prefWidth="120.0" style="-fx-font-size: 15px; -fx-font-weight: bold; margin-left: 0;" />
         </HBox>
         <VBox alignment="CENTER" spacing="18.0" styleClass="card" style="-fx-padding: 32; -fx-background-color: #fff; -fx-background-radius: 18; -fx-effect: dropshadow(gaussian, rgba(52,152,219,0.10), 12, 0, 0, 5); -fx-padding: 32 32 32 32;">
            <Label text="Book Management" styleClass="label" style="-fx-font-size: 22px; -fx-font-weight: bold; -fx-text-fill: #377dce;" minWidth="300.0" prefWidth="360.0" />
            <HBox alignment="CENTER_LEFT" spacing="16.0">
               <Label text="Book Title" styleClass="label" minWidth="120.0" prefWidth="160.0" />
               <TextField fx:id="titleField" promptText="Enter book title" minWidth="200.0" prefWidth="260.0" />
            </HBox>
            <HBox alignment="CENTER_LEFT" spacing="16.0">
               <Label text="Author" styleClass="label" minWidth="120.0" prefWidth="160.0" />
               <TextField fx:id="authorField" promptText="Enter author name" minWidth="200.0" prefWidth="260.0" />
            </HBox>
            <HBox alignment="CENTER_LEFT" spacing="16.0">
               <Label text="Status" styleClass="label" minWidth="120.0" prefWidth="160.0" />
               <ComboBox fx:id="statusComboBox" promptText="Select status" minWidth="200.0" prefWidth="260.0" />
            </HBox>
            <HBox alignment="CENTER" spacing="16.0">
               <Button fx:id="addEditButton" text="Add Book" onAction="#handleAddEditBook" styleClass="button" minWidth="120.0" prefWidth="180.0" style="-fx-font-size: 16px; -fx-font-weight: bold;" />
               <Button fx:id="deleteButton" text="Delete Book" onAction="#handleDeleteBook" styleClass="button secondary" minWidth="120.0" prefWidth="180.0" style="-fx-font-size: 16px; -fx-font-weight: bold;" />
            </HBox>
            <HBox alignment="CENTER_LEFT" spacing="16.0">
               <TextField fx:id="searchField" promptText="Search by title" minWidth="200.0" prefWidth="260.0" />
               <Button fx:id="searchButton" text="Search" onAction="#handleSearchBook" styleClass="button" minWidth="120.0" prefWidth="140.0" style="-fx-font-size: 15px;" />
            </HBox>
         </VBox>
      </VBox>
   </top>
   <center>
   <TableView fx:id="bookTable" minHeight="200.0" prefHeight="300.0" prefWidth="600.0" maxWidth="600.0" BorderPane.alignment="CENTER">
         <columns>
            <TableColumn fx:id="idCol" text="ID" prefWidth="80.0" />
            <TableColumn fx:id="titleCol" text="Title" prefWidth="220.0" />
            <TableColumn fx:id="authorCol" text="Author" prefWidth="220.0" />
            <TableColumn fx:id="statusCol" text="Status" prefWidth="120.0" />
         </columns>
         <placeholder>
            <Label text="No books to display." />
         </placeholder>
      </TableView>
   </center>
</BorderPane>
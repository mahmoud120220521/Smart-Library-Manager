<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.CheckBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.control.ScrollPane?>

<ScrollPane fitToWidth="true" fitToHeight="true" prefHeight="500.0" prefWidth="600.0" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.smartlibrarymanager.controller.LoginController" stylesheets="@./styles.css">
   <content>
   <VBox alignment="CENTER" spacing="0.0" style="-fx-padding: 0;" minWidth="350.0" prefWidth="400.0">
      <VBox alignment="CENTER" spacing="18.0" styleClass="card" style="-fx-padding: 32; -fx-background-color: #fff; -fx-background-radius: 18; -fx-effect: dropshadow(gaussian, rgba(52,152,219,0.10), 12, 0, 0, 5);">
         <Label text="Login to Your Account" styleClass="label" style="-fx-font-size: 22px; -fx-font-weight: bold; -fx-text-fill: #377dce;" minWidth="300.0" prefWidth="360.0" />
         <HBox alignment="CENTER_LEFT" spacing="16.0">
            <Label text="Email" styleClass="label" minWidth="120.0" prefWidth="160.0" />
            <TextField fx:id="emailField" promptText="Enter your email" minWidth="200.0" prefWidth="260.0" />
         </HBox>
         <HBox alignment="CENTER_LEFT" spacing="16.0">
            <Label text="Password" styleClass="label" minWidth="120.0" prefWidth="160.0" />
            <PasswordField fx:id="passwordField" promptText="Enter your password" minWidth="200.0" prefWidth="260.0" />
         </HBox>
         <CheckBox fx:id="rememberMeCheckBox" text="Remember Me" style="-fx-font-size: 14px;" />
         <HBox alignment="CENTER" spacing="16.0">
            <Button fx:id="loginButton" text="Login" onAction="#handleLogin" styleClass="button" minWidth="120.0" prefWidth="180.0" style="-fx-font-size: 16px; -fx-font-weight: bold;" />
            <Button text="Sign Up" onAction="#handleSignup" styleClass="button secondary" minWidth="120.0" prefWidth="180.0" style="-fx-font-size: 16px; -fx-font-weight: bold;" />
         </HBox>
      </VBox>
   </VBox>
   </content>
</ScrollPane>
<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.VBox?>

<BorderPane prefHeight="600.0" prefWidth="800.0" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.smartlibrarymanager.controller.DashboardController" stylesheets="@./styles.css">
   <top>
      <Label fx:id="welcomeLabel" text="Welcome to Smart Library Manager" styleClass="label" alignment="CENTER" BorderPane.alignment="CENTER" style="-fx-font-size: 28px; -fx-font-weight: bold; -fx-text-fill: #377dce; -fx-padding: 28px;" />
   </top>
   <left>
      <VBox styleClass="vbox" prefWidth="200.0">
         <padding>
            <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
         </padding>
         <Button text="Books" onAction="#handleBooks" minWidth="120.0" prefWidth="180.0" styleClass="button" style="-fx-font-size: 16px; -fx-font-weight: bold;" />
         <Button text="Members" onAction="#handleMembers" minWidth="120.0" prefWidth="180.0" styleClass="button" style="-fx-font-size: 16px; -fx-font-weight: bold;" />
         <Button text="Borrowing" onAction="#handleBorrowing" minWidth="120.0" prefWidth="180.0" styleClass="button" style="-fx-font-size: 16px; -fx-font-weight: bold;" />
         <Button fx:id="reportsButton" text="Reports" onAction="#handleReports" minWidth="120.0" prefWidth="180.0" styleClass="button" style="-fx-font-size: 16px; -fx-font-weight: bold;" />
         <Button fx:id="logoutButton" text="Logout" onAction="#handleLogout" minWidth="120.0" prefWidth="180.0" styleClass="button secondary" style="-fx-font-size: 16px; -fx-font-weight: bold;" />
      </VBox>
   </left>
   <center>
      <VBox alignment="CENTER" styleClass="center">
         <Label text="Select a section from the left menu to get started." styleClass="label" alignment="CENTER" style="-fx-font-size: 18px; -fx-text-fill: #222e3a; -fx-padding: 12px;" />
      </VBox>
   </center>
</BorderPane>